# ──────────────────────────────────────────────────────────────────────────────
# Stock Invoice – Backend Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# ──────────────────────────────────────────────────────────────────────────────

# Runtime environment: "development" | "production"
ENVIRONMENT=development

# ── Extraction / AI ───────────────────────────────────────────────────────────
# Provider used to extract line-items from uploaded images: "groq" | "anthropic"
EXTRACTION_PROVIDER=groq

GROQ_API_KEY=
# Vision model used by Groq (override only if you want to switch models)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

ANTHROPIC_API_KEY=

# Fuzzy-matching threshold (0-100). Lower = more lenient matches.
MATCH_THRESHOLD=85

# ── Invoice Renderer ──────────────────────────────────────────────────────────
# PDF backend: "xhtml2pdf" (default, zero-dependency) | "weasyprint"
INVOICE_RENDERER=xhtml2pdf

# ── Authentication ────────────────────────────────────────────────────────────
# JWT_SECRET_KEY: set a long random string (e.g. `openssl rand -hex 32`).
# Keep it stable — changing it invalidates all issued tokens and forces everyone
# to log in again.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Full session length before re-login is required (no refresh-token flow).
# 10080 = 7 days in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used to build links in emails (password-reset, etc.)
FRONTEND_URL=http://localhost:5173

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Required for password-reset emails. Leave blank to skip email sending.
# Get your key at https://resend.com
RESEND_API_KEY=
# "From" address — must be a verified sender domain in your Resend account.
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Required to send invoices via WhatsApp. Leave blank to mock/log instead.
# Business app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# API version — update only if Meta deprecates v21.0
WHATSAPP_API_VERSION=v21.0
