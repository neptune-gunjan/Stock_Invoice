GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MATCH_THRESHOLD=85
SHOP_NAME=My Shop
SHOP_ADDRESS=

# WhatsApp Cloud API (Meta Business app -> WhatsApp -> API Setup).
# Leave blank to run with WhatsApp sending mocked/logged instead of sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Authentication.
# JWT_SECRET_KEY: set a long random string. Keep it stable -- changing it
#   invalidates every issued token and forces all users to log in again.
# ACCESS_TOKEN_EXPIRE_MINUTES: full session length before re-login is required
#   (there is no refresh-token flow). 10080 = 7 days.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
